rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'plan']) &&
             data.keys().hasOnly(['email', 'name', 'plan', 'avatar', 'provider', 'createdAt', 'lastLogin']) &&
             data.email is string && data.email.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.plan in ['Free', 'Premium'];
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }
  }
}
